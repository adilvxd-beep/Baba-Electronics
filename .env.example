# -------------------------------------------------------------
# BABA ELECTRONICS E-COMMERCE PLATFORM - ENVIRONMENT VARIABLES
# -------------------------------------------------------------

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NODE_ENV="development"
SUPER_ADMIN_PHONE="9990333434"

# PostgreSQL Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/baba_electronics?schema=public"

# Redis Cache & BullMQ Queue
REDIS_URL="redis://localhost:6379"

# NextAuth / Session Secret
NEXTAUTH_SECRET="change-this-to-a-super-secret-random-key"
NEXTAUTH_URL="http://localhost:3000"

# Google Cloud OAuth 2.0
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Indian SMS Gateway (MSG91 DLT)
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="BABAEL"
MSG91_OTP_TEMPLATE_ID=""

# WhatsApp Business Cloud API (Meta)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# Razorpay India Payment Gateway
RAZORPAY_KEY_ID="rzp_test_xxxxxxxx"
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Shiprocket Courier API
SHIPROCKET_API_EMAIL=""
SHIPROCKET_API_PASSWORD=""

# Cloudflare R2 / AWS S3 (Media & Gerber Specs)
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
S3_BUCKET_NAME="baba-electronics-storage"
S3_PUBLIC_DOMAIN=""
